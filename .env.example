# Postgres serverless (Neon) — https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clave para firmar los tokens de acceso (JWT HS256, 15 minutos). Genera una aleatoria: `openssl rand -hex 32`.
AUTH_SECRET=

# Zona horaria de la familia para calcular "hoy" (opcional; por defecto America/Mexico_City).
APP_TIMEZONE=America/Mexico_City

# IA (OPCIONAL) — https://aistudio.google.com/apikey
# El reconocimiento de comercios es determinista y NO usa IA. Gemini solo se consulta como último recurso,
# para descripciones sin nada utilizable, y únicamente si MERCHANT_AI_FALLBACK="on".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
MERCHANT_AI_FALLBACK="off"

# Los movimientos que llegan por /api/movements usan Gemini automáticamente, solo cuando las reglas del sistema
# no identifican algo y existe GEMINI_API_KEY. Sin llave, quedan por confirmar.

# Bot de Telegram — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""

# Secreto del webhook de Telegram — genera uno random (ej. `openssl rand -hex 32`)
# y pásalo como `secret_token` al registrar el webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<ESTE_VALOR>"
# Sin esto, /api/telegram/webhook rechaza todas las peticiones (401).
TELEGRAM_WEBHOOK_SECRET=""

CRON_SECRET=""

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"
