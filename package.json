{
  "name": "maybe-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsx --test \"src/domain/**/*.test.ts\" \"src/lib/**/*.test.ts\" \"src/application/**/*.test.ts\" \"src/infrastructure/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:smoke": "tsx --env-file=.env.local scripts/smoke-test-ledger.ts && tsx --env-file=.env.local scripts/smoke-test-recurring.ts && tsx --env-file=.env.local scripts/smoke-test-cashflow.ts && tsx --env-file=.env.local scripts/smoke-test-auth.ts && tsx --env-file=.env.local scripts/smoke-test-csv-import.ts && tsx --env-file=.env.local scripts/smoke-test-merchants.ts",
    "dev:e2e": "sh -c 'set -a; . ./.env.e2e; set +a; next dev -p 3001'",
    "dev:e2e:transactions": "sh -c 'set -a; . ./.env.e2e-transactions; set +a; next dev -p 3002'",
    "dev:e2e:accounts": "sh -c 'set -a; . ./.env.e2e-accounts; set +a; next dev -p 3003'",
    "dev:e2e:settings": "sh -c 'set -a; . ./.env.e2e-settings; set +a; next dev -p 3004'",
    "dev:e2e:budgets": "sh -c 'set -a; . ./.env.e2e-budgets; set +a; next dev -p 3005'",
    "seed:e2e": "sh -c 'set -a; . ./.env.e2e; set +a; tsx scripts/seed-e2e.ts'",
    "reset:e2e": "sh -c 'set -a; . ./.env.e2e; set +a; tsx scripts/reset-e2e.ts'",
    "test:e2e": "sh -c 'set -a; . ./.env.e2e; set +a; cypress run --spec \"cypress/e2e/dashboard/**/*.cy.ts\"'",
    "test:e2e:transactions": "sh -c 'set -a; . ./.env.e2e-transactions; set +a; cypress run --spec \"cypress/e2e/transactions/**/*.cy.ts\"'",
    "test:e2e:accounts": "sh -c 'set -a; . ./.env.e2e-accounts; set +a; cypress run --spec \"cypress/e2e/accounts/**/*.cy.ts\"'",
    "test:e2e:settings": "sh -c 'set -a; . ./.env.e2e-settings; set +a; cypress run --spec \"cypress/e2e/settings/**/*.cy.ts\"'",
    "test:e2e:budgets": "sh -c 'set -a; . ./.env.e2e-budgets; set +a; cypress run --spec \"cypress/e2e/budgets/**/*.cy.ts\"'",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:transactions && npm run test:e2e:accounts && npm run test:e2e:settings && npm run test:e2e:budgets",
    "statements:inspect": "tsx scripts/inspect-statement.ts",
    "shadcn:localize": "tsx scripts/localize-shadcn.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gravity-ui/icons": "^2.22.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.4.6",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^62.1.0"
  },
  "packageManager": "pnpm@10.33.1"
}
